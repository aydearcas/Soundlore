  skos:notation "SL000678"^^slv:UniqueID ;
  skos:notation "PRD.05"^^slv:TreeNumber ;
  skos:definition "A deliberate or incidental alteration of a signal that changes its waveform and often adds harmonics through clipping or saturation."@en ;
