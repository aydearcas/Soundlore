  skos:broader sl:SL000688 ;
  skos:exactMatch wd:Q931470 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Octave_effect> ;
  slv:promptAdherenceExpected "high" ;
  slv:definitionStatus "draft" .

