  skos:notation "SL000676"^^slv:UniqueID ;
  skos:notation "PRD.04.03"^^slv:TreeNumber ;
  skos:definition "An effect that combines a signal with phase-shifted copies, creating moving frequency notches and a sweeping timbre."@en ;
  skos:broader sl:SL000673 ;
  skos:exactMatch wd:Q1551588 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Phaser_(effect)> ;
