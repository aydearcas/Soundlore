sl:SL000008 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "9/8 time"@en ;
  skos:notation "SL000008"^^slv:UniqueID ;
  skos:notation "RHY.01.02.02"^^slv:TreeNumber ;
  skos:definition "A time signature containing nine eighth notes per bar, usually grouped into three beats but sometimes organized asymmetrically."@en ;
  skos:scopeNote "Three triple-divided beats, or aksak groupings (2+2+2+3)."@en ;
  skos:broader sl:SL000006 ;
  skos:related sl:SL000017 ;
  slv:promptTerm "9/8 time" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000009 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "12/8 time"@en ;
  skos:notation "SL000009"^^slv:UniqueID ;
  skos:notation "RHY.01.02.03"^^slv:TreeNumber ;
  skos:definition "A time signature usually felt as four dotted-quarter-note beats per bar, each divided into three eighth notes."@en ;
  skos:scopeNote "Four triple-divided beats; slow blues, soul, rock and roll ballads."@en ;
  skos:broader sl:SL000006 ;
  skos:related sl:SL000025, sl:SL000026 ;
  slv:promptTerm "12/8 time", "slow blues" ;
  slv:promptAdherenceExpected "low" ;
