  skos:scopeNote "Metallic amplifier reverb; surf."@en ;
  skos:broader sl:SL000662 ;
  slv:promptTerm "spring reverb" ;
  slv:promptAdherenceExpected "high" ;
  slv:definitionStatus "draft" .

sl:SL000666 a skos:Concept ;
