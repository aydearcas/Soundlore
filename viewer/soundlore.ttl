sl:SL000685 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Resonant filter"@en ;
  skos:notation "SL000685"^^slv:UniqueID ;
  skos:notation "PRD.06.02"^^slv:TreeNumber ;
  skos:altLabel "squelch"@en ;
