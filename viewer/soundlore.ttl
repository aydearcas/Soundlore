  skos:notation "SL000667"^^slv:UniqueID ;
  skos:notation "PRD.03.01.05"^^slv:TreeNumber ;
  skos:definition "A reverberation effect combined with pitch-shifted feedback, often adding sustained upper-octave layers to the decay."@en ;
  skos:scopeNote "Reverb with an added upper octave."@en ;
