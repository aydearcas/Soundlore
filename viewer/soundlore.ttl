  skos:notation "SL000010"^^slv:UniqueID ;
  skos:notation "RHY.01.03"^^slv:TreeNumber ;
  skos:altLabel "odd time signature"@en ;
  skos:definition "A meter whose subdivisions form unequal beat groups, such as 2+3 or 2+2+3, rather than a regular duple or triple pattern."@en ;
  skos:scopeNote "Bars whose beats don't group evenly."@en ;
