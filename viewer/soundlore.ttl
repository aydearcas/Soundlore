sl:SL000692 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Slowed and reverb"@en ;
  skos:notation "SL000692"^^slv:UniqueID ;
  skos:notation "PRD.07.04"^^slv:TreeNumber ;
  skos:altLabel "chopped and screwed"@en ;
  skos:definition "A production treatment that slows a recording and adds reverberation, often lowering pitch when playback speed is reduced; it is distinct from chopped-and-screwed editing."@en ;
  skos:scopeNote "Slowed-down version with reverb; or the chopped and screwed technique."@en ;
  skos:broader sl:SL000688 ;
  slv:promptTerm "slowed and reverb", "chopped and screwed" ;
