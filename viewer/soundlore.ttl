  slv:definitionStatus "draft" .

sl:SL000012 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "5/8 time"@en ;
  skos:notation "SL000012"^^slv:UniqueID ;
  skos:notation "RHY.01.03.02"^^slv:TreeNumber ;
  skos:definition "A time signature containing five eighth notes per bar, commonly grouped as two plus three or three plus two."@en ;
  skos:scopeNote "Five eighth notes, grouped 2+3 or 3+2."@en ;
  skos:broader sl:SL000010 ;
  skos:related sl:SL000017 ;
  slv:promptTerm "5/8 time" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000013 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "7/8 time"@en ;
  skos:notation "SL000013"^^slv:UniqueID ;
  skos:notation "RHY.01.03.03"^^slv:TreeNumber ;
  skos:definition "A time signature containing seven eighth notes per bar, commonly arranged in unequal groups such as 2+2+3."@en ;
  skos:scopeNote "Seven eighth notes (2+2+3, 3+2+2…); prog rock, Balkan music."@en ;
  skos:broader sl:SL000010 ;
  skos:related sl:SL000017 ;
  slv:promptTerm "7/8 time" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000014 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "7/4 time"@en ;
  skos:notation "SL000014"^^slv:UniqueID ;
  skos:notation "RHY.01.03.04"^^slv:TreeNumber ;
  skos:definition "A time signature containing seven quarter notes per bar, often grouped into smaller units such as four plus three."@en ;
  skos:scopeNote "Seven quarter notes per bar."@en ;
  skos:broader sl:SL000010 ;
  slv:promptTerm "7/4 time" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000015 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "11/8 time"@en ;
  skos:notation "SL000015"^^slv:UniqueID ;
  skos:notation "RHY.01.03.05"^^slv:TreeNumber ;
  skos:definition "A time signature containing eleven eighth notes per bar, typically organized into unequal groups of two and three."@en ;
  skos:scopeNote "Eleven eighth notes; Balkan folk, progressive metal."@en ;
  skos:broader sl:SL000010 ;
  skos:related sl:SL000017 ;
  slv:promptTerm "11/8 time" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000016 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "13/8 time"@en ;
  skos:notation "SL000016"^^slv:UniqueID ;
  skos:notation "RHY.01.03.06"^^slv:TreeNumber ;
  skos:definition "A time signature containing thirteen eighth notes per bar, typically organized into an asymmetrical sequence of smaller beat groups."@en ;
  skos:scopeNote "Thirteen eighth notes; prog rock and math rock."@en ;
  skos:broader sl:SL000010 ;
  slv:promptTerm "13/8 time" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000017 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Aksak rhythm"@en ;
  skos:notation "SL000017"^^slv:UniqueID ;
  skos:notation "RHY.01.03.07"^^slv:TreeNumber ;
  skos:definition "An asymmetrical rhythmic organization built from unequal short and long beat units, particularly associated with Turkish and Balkan traditions."@en ;
  skos:scopeNote "Uneven groupings of 2s and 3s typical of Turkey and the Balkans."@en ;
  skos:broader sl:SL000010 ;
  skos:related sl:SL000008, sl:SL000012, sl:SL000013, sl:SL000015 ;
  skos:exactMatch wd:Q2829148 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Aksak> ;
  slv:promptTerm "balkan rhythm", "odd meter" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000018 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Mixed meter"@en ;
  skos:notation "SL000018"^^slv:UniqueID ;
  skos:notation "RHY.01.04"^^slv:TreeNumber ;
  skos:notation "RHY.01.03.08"^^slv:TreeNumber ;
  skos:altLabel "changing meter"@en ;
  skos:definition "The use of changing time signatures within a piece or passage, producing successive bars with different beat groupings."@en ;
  skos:scopeNote "Frequent alternation of different time signatures within a section."@en ;
  skos:broader sl:SL000001, sl:SL000010 ;
  skos:related sl:SL000048 ;
  slv:promptTerm "changing time signatures", "mixed meter" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000019 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Free meter"@en ;
  skos:notation "SL000019"^^slv:UniqueID ;
  skos:notation "RHY.01.05"^^slv:TreeNumber ;
  skos:altLabel "ad libitum"@en, "unmeasured"@en ;
  skos:definition "Music without a consistently recurring metrical pattern; timing may instead follow melodic phrasing, text, or expressive needs."@en ;
  skos:scopeNote "Passages without a regular pulse, shaped by the phrase."@en ;
  skos:broader sl:SL000001 ;
  skos:related sl:SL000060 ;
  skos:exactMatch wd:Q5500333 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Free_time_(music)> ;
  slv:promptTerm "free time", "rubato", "ad lib" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000020 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Hemiola"@en ;
  skos:notation "SL000020"^^slv:UniqueID ;
  skos:notation "RHY.01.06"^^slv:TreeNumber ;
  skos:definition "A rhythmic or metrical effect in which a span normally grouped in twos is heard in threes, or vice versa, often creating a 3:2 relationship."@en ;
  skos:scopeNote "Three duple beats laid over or alternating with two triple ones (metric 3:2)."@en ;
  skos:broader sl:SL000001 ;
  skos:related sl:SL000007, sl:SL000036 ;
  skos:exactMatch wd:Q1430673 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Hemiola> ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000021 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Polymeter"@en ;
  skos:notation "SL000021"^^slv:UniqueID ;
  skos:notation "RHY.01.07"^^slv:TreeNumber ;
  skos:definition "The simultaneous use of different metrical groupings in separate musical parts, often over a shared underlying pulse."@en ;
  skos:scopeNote "Simultaneous layers in different meters sharing a pulse."@en ;
  skos:broader sl:SL000001 ;
  skos:related sl:SL000036 ;
  slv:promptTerm "polymeter" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000022 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Rhythmic feel"@en ;
  skos:notation "SL000022"^^slv:UniqueID ;
  skos:notation "RHY.02"^^slv:TreeNumber ;
  skos:altLabel "feel"@en, "groove"@en ;
  skos:definition "The perceived character of a rhythm, shaped by subdivision, accent, timing, and the placement of notes around the beat."@en ;
  skos:scopeNote "How the pulse is subdivided and placed, beyond the time signature."@en ;
  skos:topConceptOf <urn:soundlore:scheme> ;
  skos:narrower sl:SL000023, sl:SL000024, sl:SL000025, sl:SL000026, sl:SL000027, sl:SL000028, sl:SL000029, sl:SL000030 ;
  slv:promptTerm "groove" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000023 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Straight feel"@en ;
  skos:notation "SL000023"^^slv:UniqueID ;
  skos:notation "RHY.02.01"^^slv:TreeNumber ;
  skos:altLabel "straight eighths"@en ;
  skos:definition "A rhythmic feel in which equal written subdivisions are performed with approximately equal durations rather than a swing pattern."@en ;
  skos:scopeNote "Even subdivisions, no swing."@en ;
  skos:broader sl:SL000022 ;
  slv:promptTerm "straight beat" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000024 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Swing"@en ;
  skos:notation "SL000024"^^slv:UniqueID ;
  skos:notation "RHY.02.02"^^slv:TreeNumber ;
  skos:altLabel "swung eighths"@en ;
  skos:definition "A rhythmic feel with unequal subdivisions and flexible timing, often giving paired eighth notes a long-short character."@en ;
  skos:scopeNote "Uneven (long-short) eighth notes built on a triplet."@en ;
  skos:broader sl:SL000022 ;
  skos:related sl:SL000025, sl:SL000026 ;
  skos:exactMatch wd:Q14867674 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Swing_time> ;
  slv:promptTerm "swing", "swung rhythm" ;
  slv:promptAdherenceExpected "medium" ;
  slv:definitionStatus "draft" .

sl:SL000025 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Shuffle"@en ;
  skos:notation "SL000025"^^slv:UniqueID ;
  skos:notation "RHY.02.03"^^slv:TreeNumber ;
  skos:definition "A repeated long-short subdivision pattern, commonly based on triplets and widely used in blues, boogie-woogie, and related styles."@en ;
  skos:scopeNote "A steady, pronounced swing pattern; the basis of blues and boogie."@en ;
  skos:broader sl:SL000022 ;
  skos:related sl:SL000024, sl:SL000009, sl:SL000086 ;
  slv:promptTerm "shuffle", "shuffle groove" ;
  slv:promptAdherenceExpected "medium" ;
  slv:definitionStatus "draft" .

sl:SL000026 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Triplet feel"@en ;
  skos:notation "SL000026"^^slv:UniqueID ;
  skos:notation "RHY.02.04"^^slv:TreeNumber ;
  skos:definition "A rhythmic feel in which the beat is regularly divided into three parts, whether all three subdivisions are sounded or not."@en ;
  skos:scopeNote "A pulse consistently subdivided into three."@en ;
  skos:broader sl:SL000022 ;
  skos:related sl:SL000009, sl:SL000007, sl:SL000024 ;
  slv:promptTerm "triplet feel" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000027 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Half-time feel"@en ;
  skos:notation "SL000027"^^slv:UniqueID ;
  skos:notation "RHY.02.05"^^slv:TreeNumber ;
  skos:definition "A rhythmic feel that makes the music seem slower by placing major accents at half their usual rate without necessarily changing the tempo."@en ;
  skos:scopeNote "The snare lands every other beat, so the music feels half as fast."@en ;
  skos:broader sl:SL000022 ;
  skos:related sl:SL000028, sl:SL000072 ;
  skos:exactMatch wd:Q5641839 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Half-time_(music)> ;
  slv:promptTerm "half-time", "half time groove" ;
  slv:promptAdherenceExpected "medium" ;
  slv:definitionStatus "draft" .

sl:SL000028 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Double-time feel"@en ;
  skos:notation "SL000028"^^slv:UniqueID ;
  skos:notation "RHY.02.06"^^slv:TreeNumber ;
  skos:definition "A rhythmic feel that makes the music seem faster by doubling the rate of prominent subdivisions or accents without necessarily changing the tempo."@en ;
  skos:scopeNote "Percussion doubles the apparent speed of the pulse."@en ;
  skos:broader sl:SL000022 ;
  skos:related sl:SL000027 ;
  slv:promptTerm "double-time", "double time" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000029 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Laid-back feel"@en ;
  skos:notation "SL000029"^^slv:UniqueID ;
  skos:notation "RHY.02.07"^^slv:TreeNumber ;
  skos:altLabel "behind the beat"@en, "in the pocket"@en ;
  skos:definition "A timing approach in which notes sit slightly behind the expected beat, creating a relaxed or spacious groove."@en ;
  skos:scopeNote "Playing slightly behind the beat for a relaxed feel."@en ;
  skos:broader sl:SL000022 ;
  slv:promptTerm "laid-back groove" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000030 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Driving feel"@en ;
  skos:notation "SL000030"^^slv:UniqueID ;
  skos:notation "RHY.02.08"^^slv:TreeNumber ;
  skos:altLabel "ahead of the beat"@en ;
  skos:definition "A rhythm with persistent forward momentum, created through strong pulse, repeated accents, or assertive placement of notes."@en ;
  skos:scopeNote "Playing ahead of or insistently on the beat for urgency."@en ;
  skos:broader sl:SL000022 ;
  slv:promptTerm "driving rhythm" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000031 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Rhythmic devices"@en ;
  skos:notation "SL000031"^^slv:UniqueID ;
  skos:notation "RHY.03"^^slv:TreeNumber ;
  skos:definition "A compositional or performance technique that shapes rhythmic organization, accent, repetition, or the relationship between musical parts."@en ;
  skos:scopeNote "Techniques that alter or enrich the basic pattern."@en ;
  skos:topConceptOf <urn:soundlore:scheme> ;
  skos:narrower sl:SL000032, sl:SL000033, sl:SL000034, sl:SL000035, sl:SL000036, sl:SL000040, sl:SL000044, sl:SL000045, sl:SL000046, sl:SL000047, sl:SL000048, sl:SL000049, sl:SL000050 ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000032 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Syncopation"@en ;
  skos:notation "SL000032"^^slv:UniqueID ;
  skos:notation "RHY.03.01"^^slv:TreeNumber ;
  skos:definition "The emphasis of normally weak beats or subdivisions, or the displacement of accents away from the expected metrical pattern."@en ;
  skos:scopeNote "Accents on weak beats or between beats."@en ;
  skos:broader sl:SL000031 ;
  skos:related sl:SL000033 ;
  skos:exactMatch wd:Q319526 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Syncopation> ;
  slv:promptTerm "syncopated rhythm" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000033 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Anticipation"@en ;
  skos:notation "SL000033"^^slv:UniqueID ;
  skos:notation "RHY.03.02"^^slv:TreeNumber ;
  skos:altLabel "push"@en ;
  skos:definition "A note or chord sounded before its expected rhythmic or harmonic position, creating a sense of forward motion."@en ;
  skos:scopeNote "A note or chord that arrives before the strong beat it was expected on."@en ;
  skos:broader sl:SL000031 ;
  skos:related sl:SL000032 ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000034 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Offbeat"@en ;
  skos:notation "SL000034"^^slv:UniqueID ;
  skos:notation "RHY.03.03"^^slv:TreeNumber ;
  skos:altLabel "upbeat"@en, "afterbeat"@en ;
  skos:definition "A beat or subdivision outside the main metrical accents, often emphasized to create rhythmic contrast or syncopation."@en ;
  skos:scopeNote "Systematic accenting of the weak parts of the beat."@en ;
  skos:broader sl:SL000031 ;
  skos:related sl:SL000605 ;
  slv:promptTerm "offbeat rhythm" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000035 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Backbeat"@en ;
  skos:notation "SL000035"^^slv:UniqueID ;
  skos:notation "RHY.03.04"^^slv:TreeNumber ;
  skos:definition "A strong accent on the second and fourth beats of a four-beat bar, commonly played on the snare drum in popular music."@en ;
  skos:scopeNote "Snare accent on beats 2 and 4 of a 4/4 bar."@en ;
  skos:broader sl:SL000031 ;
  skos:related sl:SL000064 ;
  slv:promptTerm "backbeat" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000036 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Polyrhythm"@en ;
  skos:notation "SL000036"^^slv:UniqueID ;
  skos:notation "RHY.03.05"^^slv:TreeNumber ;
  skos:definition "The simultaneous use of contrasting rhythmic divisions, such as three evenly spaced notes against two over the same duration."@en ;
  skos:scopeNote "Two or more conflicting subdivisions at once (3:2, 4:3…)."@en ;
  skos:broader sl:SL000031 ;
  skos:narrower sl:SL000037, sl:SL000038, sl:SL000039 ;
  skos:related sl:SL000020, sl:SL000021, sl:SL000587 ;
  skos:exactMatch wd:Q747529 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Polyrhythm> ;
  slv:promptTerm "polyrhythmic", "polyrhythms" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000037 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Three against two"@en ;
  skos:notation "SL000037"^^slv:UniqueID ;
  skos:notation "RHY.03.05.01"^^slv:TreeNumber ;
  skos:altLabel "3:2"@en ;
  skos:definition "A polyrhythm in which three evenly spaced events occur against two evenly spaced events within the same time span."@en ;
  skos:scopeNote "Three even notes against two in the same span."@en ;
  skos:broader sl:SL000036 ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000038 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Four against three"@en ;
  skos:notation "SL000038"^^slv:UniqueID ;
  skos:notation "RHY.03.05.02"^^slv:TreeNumber ;
  skos:altLabel "4:3"@en ;
  skos:definition "A polyrhythm in which four evenly spaced events occur against three evenly spaced events within the same time span."@en ;
  skos:scopeNote "Four notes against three in the same span."@en ;
  skos:broader sl:SL000036 ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000039 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Cross-rhythm"@en ;
  skos:notation "SL000039"^^slv:UniqueID ;
  skos:notation "RHY.03.05.03"^^slv:TreeNumber ;
  skos:definition "A sustained rhythmic relationship in which one pattern conflicts with the main beat grouping, often serving as a structural feature."@en ;
  skos:scopeNote "Sustained polyrhythm as a structural basis, typical of West African music."@en ;
  skos:broader sl:SL000036 ;
  skos:exactMatch wd:Q1141117 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Cross-beat> ;
  slv:promptTerm "african cross-rhythm" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000040 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Clave"@en ;
  skos:notation "SL000040"^^slv:UniqueID ;
  skos:notation "RHY.03.06"^^slv:TreeNumber ;
  skos:definition "A recurring guide pattern that organizes rhythmic relationships in Afro-Cuban music, commonly expressed as five strokes across two measures."@en ;
  skos:scopeNote "Five-stroke guide pattern in Afro-Cuban music."@en ;
  skos:broader sl:SL000031 ;
  skos:narrower sl:SL000041, sl:SL000042, sl:SL000043 ;
  skos:related sl:SL000550 ;
  skos:exactMatch wd:Q1099007 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Clave_(rhythm)> ;
  slv:promptTerm "clave rhythm" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000041 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Son clave"@en ;
  skos:notation "SL000041"^^slv:UniqueID ;
  skos:notation "RHY.03.06.01"^^slv:TreeNumber ;
  skos:altLabel "clave 3-2"@en, "clave 2-3"@en ;
  skos:definition "A five-stroke Afro-Cuban clave pattern with three strokes in one measure and two in the other, played in either 3-2 or 2-3 orientation."@en ;
  skos:scopeNote "Son clave in its 3-2 and 2-3 orientations."@en ;
  skos:broader sl:SL000040 ;
  slv:promptTerm "son clave" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000042 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Rumba clave"@en ;
  skos:notation "SL000042"^^slv:UniqueID ;
  skos:notation "RHY.03.06.02"^^slv:TreeNumber ;
  skos:definition "An Afro-Cuban clave pattern related to son clave, with a different placement of the final stroke on its three-stroke side."@en ;
  skos:scopeNote "Variant with the third stroke delayed."@en ;
  skos:broader sl:SL000040 ;
  slv:promptTerm "rumba clave" ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000043 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Bossa nova clave"@en ;
  skos:notation "SL000043"^^slv:UniqueID ;
  skos:notation "RHY.03.06.03"^^slv:TreeNumber ;
  skos:definition "A two-measure rhythmic pattern used in some bossa nova accompaniment, related to clave but not universally required by the style."@en ;
  skos:scopeNote "Brazilian clave variant used in bossa nova."@en ;
  skos:broader sl:SL000040 ;
  skos:related sl:SL000088 ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000044 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Tresillo"@en ;
  skos:notation "SL000044"^^slv:UniqueID ;
  skos:notation "RHY.03.07"^^slv:TreeNumber ;
  skos:altLabel "3+3+2"@en ;
  skos:definition "A three-attack rhythm often represented as 3+3+2 subdivisions within an eight-unit cycle, common in Afro-Latin music and popular styles."@en ;
  skos:scopeNote "3+3+2 grouping of eighth notes, core of Afro-Latin rhythm and today's pop."@en ;
  skos:broader sl:SL000031 ;
  skos:related sl:SL000045, sl:SL000075 ;
  skos:exactMatch wd:Q65089548 ;
  rdfs:seeAlso <https://en.wikipedia.org/wiki/Tresillo_(rhythm)> ;
  slv:promptAdherenceExpected "low" ;
  slv:definitionStatus "draft" .

sl:SL000045 a skos:Concept ;
  skos:inScheme <urn:soundlore:scheme> ;
  skos:prefLabel "Habanera rhythm"@en ;
  skos:notation "SL000045"^^slv:UniqueID ;
  skos:notation "RHY.03.08"^^slv:TreeNumber ;
  skos:definition "A characteristic four-attack rhythm, commonly represented as 3+1+2+2 subdivisions, associated with the habanera and related dance traditions."@en ;
  skos:scopeNote "Tresillo with an added note on beat two."@en ;
  skos:broader sl:SL000031 ;
  skos:related sl:SL000044 ;
