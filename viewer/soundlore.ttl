  skos:notation "SL000668"^^slv:UniqueID ;
  skos:notation "PRD.03.02"^^slv:TreeNumber ;
  skos:definition "An effect that repeats a sound after a chosen time interval, with timing and feedback controlling the rhythmic or spatial result."@en ;
  skos:scopeNote "Repetitions of the signal."@en ;
