  skos:notation "SL000674"^^slv:UniqueID ;
  skos:notation "PRD.04.01"^^slv:TreeNumber ;
  skos:definition "An effect that combines a signal with slightly delayed and pitch-varied copies to suggest multiple performers or a broader sound."@en ;
