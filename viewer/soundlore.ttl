  skos:notation "PRD.05.02"^^slv:TreeNumber ;
  skos:altLabel "tape drive"@en ;
  skos:definition "The soft compression and harmonic distortion that occur when analog tape is recorded at high levels, or a digital emulation of it."@en ;
